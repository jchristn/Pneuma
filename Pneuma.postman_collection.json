{
  "info": {
    "name": "Pneuma - information brought to life",
    "description": "REST API collection for Pneuma. Set the baseUrl variable, run 'Login' to capture a token, then call the rest.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@pneuma"
    },
    {
      "key": "adminPassword",
      "value": "password"
    },
    {
      "key": "subjectId",
      "value": ""
    },
    {
      "key": "collectionId",
      "value": ""
    },
    {
      "key": "nodeId",
      "value": ""
    },
    {
      "key": "subjectSlug",
      "value": "example-subject"
    },
    {
      "key": "turnId",
      "value": ""
    },
    {
      "key": "embeddingEndpointId",
      "value": ""
    },
    {
      "key": "completionEndpointId",
      "value": ""
    },
    {
      "key": "promptKey",
      "value": "user.answer"
    },
    {
      "key": "modelRunnerId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/api/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "OpenAPI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/openapi.json",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.token) { pm.collectionVariables.set('token', data.token); }",
                  "pm.test('has token', function () { pm.expect(data.token).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/v1.0/token"
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1.0/token"
          }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "List Tenants (paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/tenants?maxResults=100&skip=0&order=desc"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/users?maxResults=100&skip=0&order=desc&search="
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sample\",\n  \"lastName\": \"User\",\n  \"email\": \"subject@pneuma\",\n  \"password\": \"changeme\",\n  \"isTenantAdmin\": true\n}"
            },
            "url": "{{baseUrl}}/v1.0/users"
          }
        },
        {
          "name": "List Credentials",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/credentials"
          }
        },
        {
          "name": "Create Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CI key\"\n}"
            },
            "url": "{{baseUrl}}/v1.0/credentials"
          }
        },
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/roles"
          }
        },
        {
          "name": "List Permissions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/permissions"
          }
        },
        {
          "name": "List Audit",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/audit?maxResults=100&order=desc"
          }
        },
        {
          "name": "List Model Runners (model endpoints)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/model-runners"
          }
        },
        {
          "name": "Model Endpoint Health (all, dedup by base URL)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/model-runners/health"
          }
        },
        {
          "name": "Model Endpoint Health (by id)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/model-runners/:id/health"
          }
        },
        {
          "name": "Run Health Check Now",
          "description": "Run a single health probe against the endpoint immediately (no request body). 200 returns the endpoint health object (same shape as 'Model Endpoint Health (by id)'). 400 if health checks are disabled for the endpoint; 404 if the endpoint is not found.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1.0/model-runners/{{modelRunnerId}}/health/check"
          }
        },
        {
          "name": "Create Model Endpoint",
          "description": "Managed natively by Pneuma (no external proxy). type = Embedding|Completion; provider selects the PolyPrompt provider (OpenAI, OpenAICompatible, Gemini, Ollama, AzureOpenAI, Anthropic, Bedrock, VoyageAI, VertexAI) and determines which provider-specific fields apply (deployment/apiVersion for AzureOpenAI, region/accessKeyId for Bedrock, project/region for VertexAI). Secrets (apiKey, secretAccessKey, sessionToken) are write-only and never returned on read.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json(); if (d && (d.id || d.Id)) pm.collectionVariables.set('completionEndpointId', d.id || d.Id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Completion\",\n  \"provider\": \"Ollama\",\n  \"name\": \"local-chat\",\n  \"model\": \"llama3.2\",\n  \"endpoint\": \"http://ollama:11434\",\n  \"apiFormat\": \"Ollama\",\n  \"deployment\": null,\n  \"apiVersion\": null,\n  \"region\": null,\n  \"project\": null,\n  \"accessKeyId\": null,\n  \"apiKey\": null,\n  \"secretAccessKey\": null,\n  \"sessionToken\": null,\n  \"active\": true,\n  \"maxConcurrentRequests\": 2,\n  \"maxQueueDepth\": 0,\n  \"contextSize\": 8192\n}"
            },
            "url": "{{baseUrl}}/v1.0/model-runners"
          }
        },
        {
          "name": "Update Model Endpoint",
          "description": "Update an endpoint by id. Include provider + provider-specific fields; leave a secret field null/omitted to keep the stored value. Example shows an Azure OpenAI completion endpoint.",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Completion\",\n  \"provider\": \"AzureOpenAI\",\n  \"name\": \"azure-chat\",\n  \"model\": \"gpt-4o\",\n  \"endpoint\": \"https://my-resource.openai.azure.com\",\n  \"apiFormat\": \"OpenAI\",\n  \"deployment\": \"gpt-4o\",\n  \"apiVersion\": \"2024-02-15-preview\",\n  \"region\": null,\n  \"project\": null,\n  \"accessKeyId\": null,\n  \"apiKey\": \"sk-...\",\n  \"secretAccessKey\": null,\n  \"sessionToken\": null,\n  \"active\": true,\n  \"maxConcurrentRequests\": 2,\n  \"maxQueueDepth\": 0,\n  \"contextSize\": 128000\n}"
            },
            "url": "{{baseUrl}}/v1.0/model-runners/:id"
          }
        },
        {
          "name": "List Prompts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/prompts"
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/settings"
          }
        },
        {
          "name": "Update Settings",
          "description": "GET /v1.0/settings first, edit the returned 'settings' object, and PUT it back here. Leave secret fields as '********' to keep the stored value.",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rest\": { \"hostname\": \"127.0.0.1\", \"port\": 8080, \"ssl\": false },\n  \"cors\": { \"allowOrigins\": \"*\" },\n  \"auth\": { \"tokenSigningKey\": \"********\" },\n  \"database\": { \"type\": \"Sqlite\", \"filename\": \"pneuma.db\" }\n}"
            },
            "url": "{{baseUrl}}/v1.0/settings"
          }
        },
        {
          "name": "Get Ingestion Settings",
          "description": "Read the dashboard-tunable ingestion concurrency (IngestionTuning): per-stage caps plus the job pool, summarization, and timeout knobs. Admin-only.",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/settings/ingestion"
          }
        },
        {
          "name": "Update Ingestion Settings",
          "description": "Persist and apply (live, no restart) the ingestion concurrency defaults. GET /v1.0/settings/ingestion first, then edit and PUT the same shape.",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentRetrieval\": 4,\n  \"typeDetection\": 8,\n  \"cellExtraction\": 4,\n  \"classification\": 4,\n  \"graphMerge\": 2,\n  \"summarization\": 4,\n  \"chunking\": 8,\n  \"embedding\": 4,\n  \"indexing\": 4,\n  \"maxConcurrentTasks\": 4,\n  \"summarizationConcurrency\": 4,\n  \"summarizationMinCellLength\": 200,\n  \"stageTimeoutSeconds\": 300\n}"
            },
            "url": "{{baseUrl}}/v1.0/settings/ingestion"
          }
        }
      ]
    },
    {
      "name": "Collections",
      "item": [
        {
          "name": "Create Collection",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json(); if (d && (d.id || d.Id)) pm.collectionVariables.set('collectionId', d.id || d.Id);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"general-knowledge\",\n  \"description\": \"Default ingestion collection\",\n  \"dimensionality\": 768\n}"
            },
            "url": "{{baseUrl}}/v1.0/collections"
          }
        },
        {
          "name": "List Collections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/collections"
          }
        },
        {
          "name": "Read Collection",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/collections/{{collectionId}}"
          }
        },
        {
          "name": "Delete Collection",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1.0/collections/{{collectionId}}"
          }
        }
      ]
    },
    {
      "name": "Subjects & Ingestion",
      "item": [
        {
          "name": "Create Subject",
          "description": "Optionally include a nullable-per-field `concurrencyOverrides` object (same keys as PUT /v1.0/settings/ingestion) to override ingestion concurrency for this subject; omitted/null fields inherit the system default. See the Update Subject example.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json(); if (d && d.id) pm.collectionVariables.set('subjectId', d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Example Subject\",\n  \"type\": \"Topic\",\n  \"description\": \"A demonstration subject for the API examples.\",\n  \"tagline\": \"Ask about Example Subject — answers are grounded in the archive, with sources.\",\n  \"embeddingModel\": \"{{embeddingEndpointId}}\",\n  \"inferenceModel\": \"{{completionEndpointId}}\",\n  \"collection\": \"{{collectionId}}\",\n  \"rerankingModel\": null,\n  \"promptRewriteModel\": null\n}"
            },
            "url": "{{baseUrl}}/v1.0/subjects"
          }
        },
        {
          "name": "List Subjects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/subjects?maxResults=100&order=desc&search="
          }
        },
        {
          "name": "List Subject Links",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/links?maxResults=100&order=desc"
          }
        },
        {
          "name": "List Ingestion Endpoints (models)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/ingestion/endpoints"
          }
        },
        {
          "name": "Submit Link",
          "description": "The embedding/inference models and collection are taken from the subject (configure them on the subject first). Optional labels (strings) and tags (key/value) are attached to every chunk this link produces and to its source graph node, so retrieval can later be scoped to them via a query/chat metadataFilter.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/about\",\n  \"title\": \"Example Subject - Overview\",\n  \"labels\": [\"reference\"],\n  \"tags\": {\n    \"rights\": \"public\",\n    \"source\": \"example\"\n  }\n}"
            },
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/links"
          }
        },
        {
          "name": "Submit Links (bulk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"urls\": [\n    \"https://example.com/about\",\n    \"https://example.com/overview\"\n  ],\n  \"labels\": [\"reference\"],\n  \"tags\": {\n    \"source\": \"example\"\n  }\n}"
            },
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/links/bulk"
          }
        },
        {
          "name": "List Links",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links?maxResults=100&order=desc"
          }
        },
        {
          "name": "Link Ingestion Log",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/log"
          }
        },
        {
          "name": "Link Source Document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/source"
          }
        },
        {
          "name": "Link Atoms",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/atoms"
          }
        },
        {
          "name": "Link Chunks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/chunks"
          }
        },
        {
          "name": "Link Vectors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/vectors"
          }
        },
        {
          "name": "Link Subgraph",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/links/:id/subgraph"
          }
        },
        {
          "name": "Reingest Link",
          "description": "Queues a fresh ingestion job that forces a full re-run of this link. The link's content hash is cleared first so the delta-skip can't short-circuit the pipeline. Returns 202 Accepted with the created job.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1.0/links/{{linkId}}/reingest"
          }
        },
        {
          "name": "Reingest Links (bulk)",
          "description": "Queues a fresh ingestion job per link (each forces a full re-run). Returns 202 Accepted with { queued, skipped }.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{linkId}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1.0/links/reingest"
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/jobs?status=&maxResults=100&order=desc"
          }
        },
        {
          "name": "Ingestion Activity Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/jobs/summary?bucketMinutes=15&subjectId="
          }
        },
        {
          "name": "Job Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/jobs/:id"
          }
        },
        {
          "name": "Job Log (follow)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/jobs/:id/log"
          }
        },
        {
          "name": "Restart Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1.0/jobs/:id/restart"
          }
        },
        {
          "name": "Stop Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1.0/jobs/:id/stop"
          }
        },
        {
          "name": "Get Subject by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1.0/subjects/by-slug/{{subjectSlug}}"
          }
        },
        {
          "name": "List Subject Prompts",
          "description": "Effective prompts for the subject: each { key, name, effectiveContent, globalContent, overrideContent|null, source (Global|SubjectOverride), mergeMode (Append|Replace) }.",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/prompts"
          }
        },
        {
          "name": "Set Subject Prompt Override",
          "description": "Set (or clear) the subject's override for a prompt key. mergeMode Append layers the override after the global prompt; Replace uses the override alone. Empty content clears the override (falls back to global).",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Answer in Example Subject's voice, citing sources.\",\n  \"mergeMode\": \"Append\"\n}"
            },
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/prompts/{{promptKey}}"
          }
        },
        {
          "name": "Delete Subject Prompt Override",
          "description": "Remove the subject's override for a prompt key (falls back to the global prompt). Returns 204.",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/prompts/{{promptKey}}"
          }
        },
        {
          "name": "Update Subject",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Example Subject\",\n  \"type\": \"Topic\",\n  \"description\": \"A demonstration subject for the API examples.\",\n  \"tagline\": \"Ask about Example Subject — answers are grounded in the archive, with sources.\",\n  \"urlSlug\": \"example-subject\",\n  \"thinkingEnabled\": true,\n  \"historyRetentionDays\": 90,\n  \"embeddingModel\": \"{{embeddingEndpointId}}\",\n  \"inferenceModel\": \"{{completionEndpointId}}\",\n  \"collection\": \"{{collectionId}}\",\n  \"rerankingModel\": null,\n  \"promptRewriteModel\": null,\n  \"systemPrompt\": \"Answer in Example Subject's voice where appropriate.\",\n  \"ontologyClassifyPrompt\": \"\",\n  \"ontologyDefinitionPrompt\": \"\",\n  \"rerankingPrompt\": \"\",\n  \"promptRewritePrompt\": \"\",\n  \"concurrencyOverrides\": {\n    \"embedding\": 2,\n    \"maxConcurrentTasks\": 2\n  }\n}"
            }
          }
        },
        {
          "name": "Delete Subject (async, 202)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}"
          }
        }
      ]
    },
    {
      "name": "Search & Ask",
      "item": [
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/search?q=activism&max=20"
          }
        },
        {
          "name": "Subject Retrieval Labels",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/retrieval/labels"
          }
        },
        {
          "name": "Subject Retrieval Tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/subjects/{{subjectId}}/retrieval/tags"
          }
        },
        {
          "name": "Read Node",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/graph/nodes/{{nodeId}}"
          }
        },
        {
          "name": "Node Neighbors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1.0/graph/nodes/{{nodeId}}/neighbors"
          }
        },
        {
          "name": "Ask (grounded query)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
