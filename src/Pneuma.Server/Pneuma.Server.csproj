<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>1701;1702;CS1591</NoWarn>
    <StartupObject>Pneuma.Server.Program</StartupObject>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Watson" Version="7.1.0" />
    <PackageReference Include="Radiant" Version="0.1.2" />
    <PackageReference Include="SyslogLogging" Version="2.2.1" />
    <PackageReference Include="Timestamps" Version="1.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pneuma.Core\Pneuma.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="pneuma.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
