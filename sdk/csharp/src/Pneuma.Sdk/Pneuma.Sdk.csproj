<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Pneuma.Sdk</PackageId>
		<Version>1.0.1</Version>
		<Authors>Joel Christner</Authors>
		<Description>C# SDK for the Pneuma REST API - subject knowledge-graph ingestion, search, and grounded query.</Description>
		<PackageTags>pneuma;sdk;rest;knowledge-graph;ingestion;search;llm</PackageTags>
		<RepositoryType>git</RepositoryType>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<RepositoryUrl>https://github.com/jchristn/Pneuma</RepositoryUrl>
		<PackageProjectUrl>https://github.com/jchristn/Pneuma</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
